# ==============================================================================
# DASHBOARD ESCOLAR — VARIÁVEIS DE AMBIENTE DO BACKEND PYTHON
# ==============================================================================
# 1. Copie este ficheiro para ".env" (sem o .example)
# 2. Preencha os valores abaixo com os seus dados reais
# 3. NUNCA partilhe o ficheiro .env — adicione-o ao .gitignore
# ==============================================================================

# --- GOOGLE GEMINI API ---
# Obtenha a chave em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=a_sua_chave_gemini_aqui

# --- MICROSOFT TEAMS (Credenciais escolares do educando) ---
# Email institucional da escola (ex: aluno@escola.edu.pt)
TEAMS_EMAIL=email_do_aluno@escola.edu.pt
# Password do Teams (guardada de forma segura localmente)
TEAMS_PASSWORD=password_aqui

# --- GOOGLE SHEETS ---
# ID da Google Sheet (o valor entre /d/ e /edit na URL)
# Ex: https://docs.google.com/spreadsheets/d/SEU_ID_AQUI/edit
GOOGLE_SHEET_ID=o_id_da_sua_sheet_aqui

# Nome da aba da folha onde os dados são escritos (normalmente "Folha1")
GOOGLE_SHEET_TAB=Folha1

# --- GOOGLE SERVICE ACCOUNT (para escrita direta na Sheet via API) ---
# Caminho para o ficheiro JSON da Service Account do Google Cloud
# Guia: https://docs.gspread.org/en/latest/oauth2.html#service-account
# Alternativa mais simples: usar o Apps Script Webhook (já configurado)
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json

# --- CONFIGURAÇÃO DOS CANAIS DO TEAMS ---
# Nome da equipa/turma no Teams (exatamente como aparece na interface)
TEAMS_CLASS_NAME=5G

# Canais a monitorizar (separados por vírgula, exatamente como no Teams)
TEAMS_CHANNELS=MAT,Português,HGP,CN,Inglês

